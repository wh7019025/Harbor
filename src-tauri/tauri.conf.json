{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Harbor",
  "version": "0.0.0",
  "identifier": "com.harbor.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "task-click",
        "title": "Harbor",
        "width": 1180,
        "height": 820,
        "resizable": true,
        "decorations": false,
        "backgroundColor": "#2a2a2a",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "resources": {
      "target/release/harbor_core-runtime-linux-x86_64.tar.gz": "harbor_core-runtime-linux-x86_64.tar.gz",
      "target/release/harbor_ttyd-runtime-linux-x86_64.tar.gz": "harbor_ttyd-runtime-linux-x86_64.tar.gz"
    },
    "linux": {
      "deb": {
        "depends": [],
        "files": {
          "/usr/bin/harbor_core": "target/release/harbor_core",
          "/usr/lib/harbor/ttyd": "target/release/harbor_ttyd"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

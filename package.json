{
  "name": "harbor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "vuepress"
  ],
  "scripts": {
    "core:release": "bash scripts/build_core_release.sh",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "docs:dev": "npm run dev --workspace=harbor-vuepress",
    "docs:build": "npm run build --workspace=harbor-vuepress",
    "docs:preview": "npm run preview --workspace=harbor-vuepress",
    "remote:test:up": "docker compose -f docker/remote-test/compose.yml up -d --build --wait",
    "remote:test:dev": "bash scripts/run_remote_test_dev.sh",
    "remote:test:down": "docker compose -f docker/remote-test/compose.yml down",
    "remote:test:logs": "docker compose -f docker/remote-test/compose.yml logs -f",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "bash scripts/run_tauri.sh dev",
    "tauri:build": "bash scripts/run_tauri.sh build --bundles deb"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "ansi_up": "^6.0.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.511.0",
    "monaco-editor": "^0.55.1",
    "tailwind-merge": "^3.3.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2.1",
    "tailwindcss": "^4.1.8",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}
